    ] : [
        // GENERATOR MARK: TARGETS

        // Mixed targets
        .target(
            name: "CPicoSDK",
            dependencies: [
                .target(name: "ARMClib"),
                .target(name: "CShims"),

                // GENERATOR MARK: TARGET DEPENDENCIES
            ],
            swiftSettings: [
                .enableExperimentalFeature("Extern"),
