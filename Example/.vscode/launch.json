                "monitor reset init",
                "load \"${workspaceFolder}/.build/armv7em-none-none-eabi/release/Example.elf\""
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ],
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [
                    {
                        "label": "",
                        "port": 0,
                        "type": "console"
                    }
                ]
            }
        },
        {
            "preLaunchTask": "Compile and Flash Project (picotool) [CPicoSDK]",
            "name": "SwiftPM: Example - Flash (picotool) [CPicoSDK]",
            "request": "launch",
            "type": "lldb",
            "program": "/usr/bin/true", // Dummy program to satisfy cppdbg requirements
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false
        },
    ]
