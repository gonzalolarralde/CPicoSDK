{
    "version": "0.2.0",
    "configurations": [
        {
            // Same settings as pico-vscode.
            "preLaunchTask": "Compile and Flash Project (cortex-debug) [CPicoSDK]",
            "name": "SwiftPM: Example - Debug (Cortex-Debug) [CPicoSDK]",
            "cwd": "/Users/gonzalo/src/CPicoSDK/Example/.build/plugins/PrepareEnvironmentPlugin/outputs/pico-sdk-bundle/openocd/0.12.0+dev/scripts",
            "executable": "${workspaceFolder}/.build/armv7em-none-none-eabi/release/Example.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "/Users/gonzalo/src/CPicoSDK/Example/.build/plugins/PrepareEnvironmentPlugin/outputs/pico-sdk-bundle/openocd/0.12.0+dev/openocd.exe",
            "gdbPath": "/Users/gonzalo/src/CPicoSDK/Example/.build/plugins/PrepareEnvironmentPlugin/outputs/pico-sdk-bundle/toolchain/14_2_Rel1/bin/arm-none-eabi-gdb",
            "device": "RP2350",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
            ],
            "svdFile": "/Users/gonzalo/src/CPicoSDK/Example/.build/plugins/PrepareEnvironmentPlugin/outputs/pico-sdk-bundle/sdk/2.2.0/src/rp2350/hardware_regs/RP2350.svd",
            "runToEntryPoint": "main",
            // Fix for no_flash binaries, where monitor reset halt doesn't do what is expected
