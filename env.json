{
    "vars": {
        "SWIFT_VERSION": "main-snapshot-2025-11-03",
        "SDK_VERSION": "2.2.0",
        "TOOLCHAIN_VERSION": "14_2_Rel1",
        "CMAKE_VERSION": "3.31.5",
        "NINJA_VERSION": "1.12.1",
        "PICOTOOL_VERSION": "2.2.0-a4",
        "OPENOCD_VERSION": "0.12.0+dev",
        "PICO_SDK_BUNDLE_PATH": "${PLUGIN_OUTPUT_PATH}/pico-sdk-bundle",
        "PICO_SDK_PATH": "${PICO_SDK_BUNDLE_PATH}/sdk/${SDK_VERSION}",
        "PICO_TOOLCHAIN_PATH": "${PICO_SDK_BUNDLE_PATH}/toolchain/${TOOLCHAIN_VERSION}",
        "PICOTOOL_PATH": "${PICO_SDK_BUNDLE_PATH}/picotool/${PICOTOOL_VERSION}/picotool/picotool",
        "CMAKE_PATH": "${PICO_SDK_BUNDLE_PATH}/cmake/v${CMAKE_VERSION}/bin",
        "NINJA_PATH": "${PICO_SDK_BUNDLE_PATH}/ninja/v${NINJA_VERSION}",
        "OPENOCD_PATH": "${PICO_SDK_BUNDLE_PATH}/openocd/${OPENOCD_VERSION}",
        "SWIFTLY_PATH": "${HOME}/.swiftly/bin/swiftly",
        "SDK_PATH": "${PICO_TOOLCHAIN_PATH}/arm-none-eabi",
        "LD_PATH": "${PICO_TOOLCHAIN_PATH}/bin/arm-none-eabi-ld",
        "GDB_PATH": "${PICO_TOOLCHAIN_PATH}/bin/arm-none-eabi-gdb",
        "IMPORTED_LIBS": "pico_stdlib,hardware_adc,hardware_base,hardware_boot_lock,hardware_claim,hardware_clocks,hardware_divider,hardware_dma,hardware_exception,hardware_flash,hardware_gpio,hardware_i2c,hardware_interp,hardware_irq,hardware_pio,hardware_pll,hardware_powman,hardware_pwm,hardware_rcp,hardware_resets,hardware_sha256,hardware_spi,hardware_sync,hardware_sync_spin_lock,hardware_ticks,hardware_timer,hardware_uart,hardware_vreg,hardware_watchdog,hardware_xip_cache,hardware_xosc,pico_aon_timer,pico_flash,pico_i2c_slave,pico_multicore,pico_rand,pico_sha256,pico_status_led,pico_stdio,pico_stdio_rtt,pico_stdio_uart,pico_stdlib_headers,pico_sync,pico_time,pico_unique_id,pico_util,pico_stdio_usb",
        "SWIFTPM_TRIPLE": "armv7em-none-none-eabi",
        "BUILD_TYPE": "RelWithDebInfo",
        "BOARD": "pico2"
    },
    "combinations": {
        "pico2": {
            "vars": {
                "BOARD": "pico2",
                "IMPORTED_LIBS_MORE": ""
            },
            "traits": ["Variant_RP2350A", "Radio_None"]
        },
        "pico2_w": {
            "vars": {
                "BOARD": "pico2_w",
                "IMPORTED_LIBS_MORE": "pico_cyw43_arch,pico_cyw43_arch_lwip_poll,pico_lwip,pico_lwip_arch,pico_lwip_http"
            },
            "traits": ["Variant_RP2350A", "Radio_CYW43439"]
        },
        "pimoroni_pico_plus2_rp2350": {
            "vars": {
                "BOARD": "pimoroni_pico_plus2_rp2350",
                "IMPORTED_LIBS_MORE": ""
            },
            "traits": ["Variant_RP2350B", "Radio_None"]
        },
        "pimoroni_pico_plus2_w_rp2350": {
            "vars": {
                "BOARD": "pimoroni_pico_plus2_w_rp2350",
                "IMPORTED_LIBS_MORE": "pico_cyw43_arch,pico_cyw43_arch_lwip_poll,pico_lwip,pico_lwip_arch,pico_lwip_http"
            },
            "traits": ["Variant_RP2350B", "Radio_CYW43439"]
        }
    }
}
